PMW_PERSISTENCE_MODE=memory
PMW_DATA_DIR=.pmw-data
PMW_SEED_MODE=seed
PMW_DEBUG=0

# auth mode: mock | feishu
PMW_AUTH_MODE=mock
NEXT_PUBLIC_PMW_AUTH_MODE=mock

# Feishu (only required when PMW_AUTH_MODE=feishu)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn

